{
  "name": "mailboxsweep.com",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:prod": "MAILBOXSWEEP_API_PORT=443 MAILBOXSWEEP_API_HOST=api.mailboxsweep.com ENV=prod next build",
    "build:staging": "MAILBOXSWEEP_API_PORT=443 MAILBOXSWEEP_API_HOST=api.staging.mailboxsweep.com ENV=staging next build",
    "build:e2e": "MAILBOXSWEEP_API_PORT=8080 MAILBOXSWEEP_API_HOST=localhost MAILBOXSWEEP_API_PROTO=http ENV=dev next build",
    "build:docker": "MAILBOXSWEEP_API_PORT=8081 MAILBOXSWEEP_API_HOST=localhost MAILBOXSWEEP_API_PROTO=http ENV=dev next build",
    "robots:staging": "cp staging.robots.txt ./out/robots.txt",
    "robots:prod": "cp prod.robots.txt ./out/robots.txt",
    "applepay:prod": "cp prod.apple-developer-merchantid-domain-association ./out/apple-developer-merchantid-domain-association",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "test:e2e": "playwright test",
    "serve": "serve -p 3000 out",
    "openapi": "docker run --rm -v \"${PWD}/..:/local\" --name client-generator openapitools/openapi-generator-cli:v7.2.0 generate -i local/openapi.yml -g typescript-fetch -o local/web/client-gen"
  },
  "dependencies": {
    "@date-io/date-fns": "^2.16.0",
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.11.0",
    "@mui/lab": "5.0.0-alpha.134",
    "@mui/material": "^5.13.1",
    "@mui/x-date-pickers": "6.16.3",
    "@next/third-parties": "^14.2.2",
    "axios": "^1.5.0",
    "currency.js": "^2.0.4",
    "date-fns": "^2.30.0",
    "debounce": "^1.2.1",
    "next": "^14.0.0",
    "next-pwa": "^5.6.0",
    "react": "^18.2.0",
    "react-beautiful-dnd": "^13.1.1",
    "react-dom": "^18.2.0",
    "react-markdown": "^9.0.0",
    "remark-gfm": "^4.0.0",
    "sharp": "^0.32.1",
    "typescript": "5.3.3",
    "webpack-subresource-integrity": "^5.2.0-rc.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.37.1",
    "@types/debounce": "^1.2.1",
    "@types/node": "20.10.7",
    "@types/react": "18.2.46",
    "@types/react-beautiful-dnd": "^13.1.4",
    "@types/react-dom": "18.2.18",
    "eslint": "8.56.0",
    "eslint-config-next": "^14.0.0",
    "prettier": "^3.1.1",
    "serve": "^14.2.1",
    "yaml": "^2.3.1",
    "yaml-loader": "^0.8.0"
  }
}

{
  "name": "mailboxsweep.com",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:prod": "MAILBOXSWEEP_API_PORT=443 MAILBOXSWEEP_API_HOST=api.mailboxsweep.com ENV=prodnext build",
    "build:staging": "MAILBOXSWEEP_API_PORT=443 MAILBOXSWEEP_API_HOST=api.staging.mailboxsweep.com ENV=staging next build",
    "robots:staging": "cp staging.robots.txt ./out/robots.txt",
    "robots:prod": "cp prod.robots.txt ./out/robots.txt",
    "start": "next start",
    "lint": "next lint",
    "openapi": "openapi --client=fetch --input=../openapi.yml --output=./client-gen --name=Mailboxsweep",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@date-io/date-fns": "^2.16.0",
    "@emotion/react": "^11.10.5",
    "@emotion/styled": "^11.10.5",
    "@mui/icons-material": "^5.11.0",
    "@mui/lab": "^5.0.0-alpha.118",
    "@mui/material": "^5.11.1",
    "@mui/x-date-pickers": "^5.0.15",
    "@next/font": "13.1.0",
    "currency.js": "^2.0.4",
    "date-fns": "^2.29.3",
    "debounce": "^1.2.1",
    "next": "^13.3.2",
    "react": "^18.2.0",
    "react-beautiful-dnd": "^13.1.1",
    "react-dom": "^18.2.0",
    "sharp": "^0.32.1",
    "typescript": "5.0.4"
  },
  "devDependencies": {
    "@types/debounce": "^1.2.1",
    "@types/node": "18.11.17",
    "@types/react": "18.0.26",
    "@types/react-beautiful-dnd": "^13.1.3",
    "@types/react-dom": "18.0.10",
    "openapi-typescript-codegen": "^0.23.0",
    "prettier": "^2.8.4",
    "yaml": "^2.2.1",
    "eslint": "8.30.0",
    "eslint-config-next": "^13.3.2"
  }
}
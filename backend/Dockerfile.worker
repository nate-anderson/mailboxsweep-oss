# syntax=docker/dockerfile:1

# Mailboxsweep HTTP API Worker Image
# MUST run in the context of the root of the repository
# so the OpenAPI spec can be copied

FROM golang:1.21

WORKDIR /opt/build

COPY ./backend/go.mod ./backend/go.sum ./

RUN go mod download

COPY ./backend ./
COPY ./openapi.yml ./

RUN make install_openapi_generator

RUN oapi-codegen -generate chi-server,types -config http_codegen.yml openapi.yml

RUN mkdir -p /opt/mailboxsweep
RUN GOOS=linux GOARCH=amd64 go build -o /opt/mailboxsweep/worker ./cmd/worker

CMD ["/opt/mailboxsweep/worker"]
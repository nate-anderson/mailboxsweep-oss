# Config for E2E tests
# This is committed to VCS, do NOT put API keys in here
# Add them as repository secrets instead

# Don't add any of these:
# - SIGNING_KEY
# - SIGNING_KEY_FILE_PATH
# - GOOGLE_OAUTH_CLIENT_ID
# - GOOGLE_OAUTH_CLIENT_SECRET
# - STRIPE_API_KEY

ENV=e2e
HTTP_PORT=8080

ALLOW_INSECURE_IMAP=true
TEST_LOGIN_SENDER_SERVER_PORT=8082
TEST_LOGIN_SENDER_SERVER_USER=testuser@mailboxsweep.local

BASE_URL=http://localhost:3000/login/token

DYNAMODB_HOST=localhost
DYNAMODB_PORT=4566
DYNAMODB_REGION=us-west-2

S3_HOST=localhost
S3_PORT=4566
S3_REGION=us-west-2

SQS_HOST=localhost
SQS_PORT=4566
SQS_REGION=us-west-2

DYNAMODB_TABLE=mailboxsweep
S3_BUCKET=mailboxsweep
SQS_CLASSIFY_QUEUE_URL=http://localhost:4566/000000000000/mailboxsweep_classify.fifo
SQS_CLASSIFY_QUEUE=mailboxsweep_classify.fifo
SQS_CLASSIFY_DLQ_URL=http://localhost:4566/000000000000/mailboxsweep_classify_dlq.fifo
SQS_CLASSIFY_DLQ=mailboxsweep_classify_dlq.fifo

SQS_COMMIT_QUEUE=mailboxsweep_commit.fifo
SQS_COMMIT_DLQ=mailboxsweep_commit_dlq.fifo
SQS_COMMIT_QUEUE_URL=http://localhost:4566/000000000000/mailboxsweep_commit.fifo
SQS_COMMIT_DLQ_URL=http://localhost:4566/000000000000/mailboxsweep_commit_dlq.fifo
CREDENTIAL_CIPHER_KEY_BASE64="VEEwXyRoZzM1MG8lRXcmcA"

LOGIN_LINK_DURATION_MINUTES=10
LOGIN_TOKEN_LENGTH=30

CHANGESET_PAGE_ID_HASH_MOD=11

SESSION_KEY_LENGTH=30
SESSION_DURATION_MINUTES=120
COOKIE_DOMAIN=localhost
COOKIE_PATH=/
DEV_MODE=true

STRIPE_CHECKOUT_SESSION_DURATION_MINUTES=30
PAYMENT_ACCESS_DURATION_DAYS=30
STRIPE_PAYMENT_CONFIRMATION_URL='http://localhost:3000/plan/payment-success?checkoutSessionId={CHECKOUT_SESSION_ID}'
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

INBOX_METADATA_TTL_MINUTES=30

CLASSIFICATION_PAGE_SIZE=30

GOOGLE_OAUTH_REDIRECT_URL=http://localhost:3000/login/gmail

MINUTES_BETWEEN_OPEN_REQUESTS=1
MINUTES_BETWEEN_CLOSED_REQUESTS=1

SES_CLASSIFY_COMPLETE_EMAIL_TEMPLATE_NAME=mailboxsweep_classify_complete
